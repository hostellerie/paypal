{# begin {templatelocation} #}

<form action="{admin_url}/plugins/paypal/index.php?mode=attributes" method="POST" enctype="multipart/form-data"  class="uk-form paypal_form">
	
<input type="hidden" name="{gltoken_name}" value="{gltoken}">
<fieldset style="margin-top: 10px;"><legend><b>{main_settings}</b></legend>
	{at_id}
	<p class="paypal-form-row">{attribute_label}<span class="paypal-required"> *</span> <input type="text" name="at_name" value="{at_name}" size="80" maxlength="255" {xhtml}></p>	
	<p class="paypal-form-row"><label>{code_label}</label> <input type="text" name="at_code" value="{code}" size="20" maxlength="30" {xhtml}></p>
	<p class="paypal-form-row">{type_label}<span class="paypal-required"> *</span> 
	<select name="at_tid">{types}</select> </p>
	<p class="paypal-form-row"><label>{price_label}</label> <input type="text" name="at_price" value="{price}" size="20" maxlength="20" {xhtml}>  {currency} </p>
	<small>{price_edit}</small>
	<p class="paypal-form-row">{image}</p>
    <p>{image_message}</p> {id_image}	
	<input type="file" dir="ltr" name="file"{xhtml}>
	{at_image}

	
	<p class="paypal-form-row"><label>{enabled}</label></p>
	<select name="at_enabled">
     <option value="0"{enabled_no}>{no}</option>
     <option value="1"{enabled_yes}>{yes}</option>
	 </select>
	</fieldset>
	
    <p><strong><span class="paypal-required"> *</span><em> {required_field}</em></strong></p>
    <select name="op" >
	<option value="save" selected="selected">{save_button}</option>
    {delete_button}
	</select>
    <input type="submit" name="submit" value="{ok_button}" {xhtml}>
    
</form>

{# end {templatelocation} #}