{# begin {templatelocation} #}

<form action="{admin_url}/plugins/paypal/index.php?mode=attributetypes" method="POST" enctype="multipart/form-data"  class="uk-form paypal_form">
	
<input type="hidden" name="{gltoken_name}" value="{gltoken}">
<fieldset style="margin-top: 10px;"><legend><b>{main_settings}</b></legend>
	{at_tid}
	<p class="paypal-form-row">{type_label}<span class="paypal-required"> *</span> <input type="text" name="type" value="{at_tname}" size="80" maxlength="255" {xhtml}></p>	
	<p class="paypal-form-row"><label>{order_label}</label> <input type="text" name="order" value="{order}" size="20" maxlength="30" {xhtml}></p>
	</fieldset>
	
    <p><strong><span class="paypal-required"> *</span><em> {required_field}</em></strong></p>
    <select name="op" >
	<option value="save" selected="selected">{save_button}</option>
    {delete_button}
	</select>
    <input type="submit" name="submit" value="{ok_button}" {xhtml}>
    
</form>

{# end {templatelocation} #}