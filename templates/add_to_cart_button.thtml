{# begin {templatelocation} #}
<div class="button_add_to_cart">
  <form method="post" action="{site_url}/checkout.php" class="jcart">
    <button type="submit">{add_to_cart}</button>
    <input type="hidden" name="submit" value="1">
    <input type="hidden" name="add" value="1">
    <input type="hidden" name="item_name" value="{name_button}">
    <input type="hidden" name="item_number" value="{id}">
    <input type="hidden" name="item_ref" value="{item_ref}">
    <input type="hidden" name="amount" value="{price2}">
    <input type="hidden" name="item_weight" value="{item_weight}">
  </form>
</div>
{# end {templatelocation} #}
