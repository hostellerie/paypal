{# begin {templatelocation} #}
<article class="paypal-product-detail">
  <header class="paypal-product-detail__header">
    <div>
      <h1>{name}</h1>
      {item_id}
    </div>
    <div class="paypal-product-detail__edit">{edit}</div>
  </header>

  <div class="paypal-product-detail__layout">
    <aside class="paypal-product-detail__media">
      {pictures}
    </aside>

    <section class="paypal-product-detail__content">
      <div class="paypal-product-detail__intro">{active} {short_description}</div>

      <div class="paypal-product-detail__price" style="{display_price}">
        {price_label} {price_ref} {discount} <strong>{price} {currency}</strong> {free_shipping}
      </div>
      <div class="paypal-product-detail__recurrent">{recurrent}</div>

      <div class="paypal-product-detail__actions">
        {add2cart}{buy_now}{login}{customisable}
      </div>

      <div class="paypal-product-detail__description">{description}</div>

      <div class="paypal-product-detail__options">
        {subscription}
        {donation}
        {rent}
      </div>

      <div class="paypal-product-detail__actions">
        {add2cart2}{buy_now2}
      </div>

      <div class="paypal-product-detail__rating">{rating}</div>
      <div class="paypal-product-detail__reviews">{review}</div>
    </section>
  </div>
</article>
{# end {templatelocation} #}
