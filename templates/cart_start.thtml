{# begin {templatelocation} #}

<!-- cart_start.thtml -->

<div id="jcart">
  {steps}
  {error_message}
  <form method="post" action="{form_action}" name="jcart">
	  <table class="paypal-cart-table">
		<tr class="paypal-cart-title-row">
		  <th id="jcart-header" colspan="4">
		  <p class="jcart-header"><strong id="jcart-title">{cart_title}</strong> ({itemcount})</p>
		  </th>
		</tr>
		  <tr class="paypal-cart-columns">
		  <td class="jcart-item-header">
		    {description}
		  </td>
		  <td class="jcart-item-header">
		    {unit_price}
		  </td>
		  <td class="jcart-item-header">
		    {quantity}
		  </td>
		<td class="jcart-item-header" style="text-align:right;">
		    {item_price}
		  </td>
		</tr>

{# end {templatelocation} #}