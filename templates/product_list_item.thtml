{# begin {templatelocation} #}
<article class="paypal-product-card">
  <div class="paypal-product-card__rating">{rating}</div>
  <div class="paypal-product-card__media">{small_pic}</div>
  <div class="paypal-product-card__body">
    <div class="paypal-product-card__title-row">
      <h2 class="paypal-product-card__title">{link_name}</h2>
      {edit}
    </div>
    <div class="paypal-product-card__description">{hidden}{short_description}</div>
    {item_id}
    <div class="paypal-product-card__meta">{details}</div>
    <div class="paypal-product-card__price" style="{display_price}">
      {price_ref} {discount} <strong>{price} {currency}</strong> {free_shipping}
    </div>
    <div class="paypal-product-card__recurrent">{recurrent}</div>
    <div class="paypal-product-card__actions">{add2cart}{buy_now}{customisable}{login}</div>
  </div>
</article>
{# end {templatelocation} #}
