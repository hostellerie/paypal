{# begin {templatelocation} #}
<form action="{site_url}/admin/plugins/paypal/subscriptions.php" method="post" class="paypal_form">
  <input type="hidden" name="{gltoken_name}" value="{gltoken}">
  <input type="hidden" name="id" value="{id}">

  <fieldset>
    <legend>{informations}</legend>

    <div class="paypal-form-grid">
      <label>
        <span>{product_id_label}</span>
        {product_id_select}
      </label>

      <label>
        <span>{user_id_label} *</span>
        {user_select}
      </label>

      <label>
        <span>{txn_id_label}</span>
        <input type="text" name="txn_id" value="{txn_id}" maxlength="255" readonly>
      </label>

      <label>
        <span>{purchase_date_label} *</span>
        <input type="date" name="purchase_date" value="{purchase_date}" required>
      </label>

      <label>
        <span>{expiration_label} *</span>
        <input type="date" name="expiration" value="{expiration}" required>
      </label>

      <label>
        <span>{price_label}</span>
        <span class="paypal-inline-field">
          <input type="number" name="price" value="{price}" min="0" step="0.01">
          <span>{currency}</span>
        </span>
      </label>

      <label>
        <span>{status_label}</span>
        <input type="text" name="status" value="{status}" maxlength="12">
      </label>

      <label>
        <span>{add_to_group_label} *</span>
        <select name="add_to_group" required>{add_to_group_options}</select>
      </label>

      <label>
        <span>{notification_label}</span>
        {notification_select}
      </label>
    </div>
  </fieldset>

  <p class="paypal-required-note">* {required_field}</p>

  <div class="paypal-form-actions">
    <button type="submit" name="mode" value="save">{save_button}</button>
    {delete_button_html}
  </div>
</form>
{# end {templatelocation} #}
