{# begin {templatelocation} #}
<article class="paypal-category-card">
  <a class="paypal-category-card__title" href="{category_link}">{category_name}</a>
  <div class="paypal-category-card__media">{cat_image}</div>
  <div class="paypal-category-card__description">{cat_description}</div>
</article>
{# end {templatelocation} #}
