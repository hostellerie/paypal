{# begin {templatelocation} #}

<div id="jcart_block" name="jcart_block" class="paypal-cart-summary">
  <div class="paypal-cart-summary__header">
    <span id="jcart-title" class="paypal-cart-summary__title">{cart_title}</span>
    <span class="paypal-cart-summary__count">{itemcount}</span>
  </div>
  <form method="post" action="{form_action}">
    <table class="paypal-cart-summary__table">

{# end {templatelocation} #}